# dbagent-agent (ISFAgent) 설정 견본.
# 이 파일을 agent.properties 로 복사해 고친 뒤 chmod 600 agent.properties 를 한다(토큰이 들어 있다).
#
# 주석이 한글(UTF-8)이다. AIX 콘솔이 EUC-KR이면 주석이 깨져 보일 수 있으나 동작에는 영향이 없다(# 줄은 읽지 않는다).
# 값(IP, 경로, 토큰 등)은 ASCII로만 쓰고, vi로 고칠 때 한글을 새로 넣지 않는 것을 권장한다.
# 아래 필수 키는 일부러 # 으로 막아 두었다 - 값을 채워 # 을 지우기 전에는 에이전트가 기동하지 않으며,
# 문제가 있으면 한꺼번에 알려 준다. # 으로 시작하는 줄은 주석이다.

# ---------------------------------------------------------------------------------------------------
# 네트워크
# ---------------------------------------------------------------------------------------------------

# 필수. 앱 서버가 접속할 이 서버(DB 서버) 자신의 IP. 모든 인터페이스를 여는 0.0.0.0 은 쓰지 않는다.
#agent.bind-address=10.0.0.11

# 수신 포트(기본 8710).
#agent.port=8710

# 선택. 앱 서버 IP(쉼표로 여러 개). 이 목록에 없는 주소의 요청은 즉시 거절한다.
# 설정을 강력히 권장한다. 이 서버 자신의 agent.bind-address 도 함께 적는다(bind-address=0.0.0.0 이면 127.0.0.1):
# start-agent.sh 와 --health / --get 은 이 서버에서 접속하므로, 빠지면 HTTP 401 이 나온다.
#agent.allowed-clients=10.0.0.5,10.0.0.11

# ---------------------------------------------------------------------------------------------------
# 인증
# ---------------------------------------------------------------------------------------------------

# hmac(기본): 모든 요청을 토큰으로 서명한다. 토큰 자체는 네트워크로 나가지 않는다.
# bearer: 단순 토큰 헤더 - TLS 없이는 토큰이 네트워크에 그대로 보인다. 시험용으로만 쓴다.
#agent.auth-mode=hmac

# hmac 이면 필수. DB InsightFlow "DB 관리" 화면에서 생성한 토큰을 붙여 넣는다(256비트, 16진수 64자, 최소 32자).
# 노드(서버)마다 서로 다른 토큰을 쓴다.
#agent.token=

# bearer 전용: 토큰 원문 대신 토큰의 SHA-256(16진수 64자).
#agent.token-sha256=

# 앱 서버와 이 서버의 시계 차이 허용치(초). 두 서버 모두 NTP로 맞춰 둔다.
#agent.clock-skew-seconds=60

# ---------------------------------------------------------------------------------------------------
# 에이전트가 읽을 수 있는 범위
# ---------------------------------------------------------------------------------------------------

# 필수. 읽기를 허용할 절대 경로 디렉터리(쉼표로 여러 개). 이 밖의 파일은 읽지 않고, 파일 심볼릭 링크도 거절한다.
# 예: ADR 기준 디렉터리(diag).
#agent.allowed-roots=/oracle/app/oracle/diag

# 필수. 이 서버의 Oracle 인스턴스 이름(영문·숫자·밑줄, 쉼표로 여러 개). 이 서버의 인스턴스마다 하나씩 적는다.
# ps -ef | grep pmon 의 ora_pmon_<SID> 로 확인한다. RAC 는 노드별 이름(예: PATDB1).
#agent.sids=PATDB1

# SID마다 필수. alert_<SID>.log 의 전체 경로(ADR trace 디렉터리 아래의 텍스트 파일).
# agent.allowed-roots 안에 있어야 한다. 키 중간의 <SID> 는 agent.sids 에 적은 이름과 같아야 한다.
#agent.sid.PATDB1.alert-log=/oracle/app/oracle/diag/rdbms/patdb/PATDB1/trace/alert_PATDB1.log

# 2단계(tkprof) 키 - 지금은 무시된다. 미리 적어 두어도 안전하다.
#agent.sid.PATDB1.trace-dir=/oracle/app/oracle/diag/rdbms/patdb/PATDB1/trace
#agent.sid.PATDB1.oracle-home=/oracle/app/oracle/product/19c
# 선택. 에이전트를 기동하는 OS 계정의 프로필에 ORACLE_HOME 이 이미 있으면 비워 둔다 - 그 값을 쓴다.
# 여기에 값을 쓰면 환경변수보다 우선한다. cron/inittab 으로 기동해 프로필이 없거나
# 서버에 Oracle 홈이 여러 개일 때 지정한다.
#agent.oracle-home=/oracle/app/oracle/product/19c
#agent.tkprof.path=
#agent.tkprof.timeout-seconds=120
#agent.tkprof.max-input-mb=500
#agent.tkprof.nice=0
#agent.trace.require-identifier=true

# ---------------------------------------------------------------------------------------------------
# 알럿 로그 읽기
# ---------------------------------------------------------------------------------------------------

# 알럿 로그의 문자셋(기본: JVM 기본 문자셋 - LANG=C 이면 ASCII). 로그에 한글 등 영문 외 글자가 있으면
# 서버의 로그 인코딩에 맞춰 UTF-8 또는 EUC-KR 로 지정한다.
#agent.alert-log.charset=UTF-8

# 참고: 이 파일의 모든 경로는 JVM 파일명 인코딩으로 표현할 수 있어야 한다. LANG=C 에서 한글 같은 비ASCII 경로는
# 기동 시 CONFIG ERROR 로 알려 준다(예전에는 스택 트레이스로 끝났다). ASCII 경로를 쓰거나,
# 경로와 맞는 LANG/LC_ALL 로 에이전트를 기동한다.

# 11g/12.1 형식 시각("Mon Oct 20 10:00:00 2026")에는 시간대가 없어서 해석에 쓰는 시간대.
# 기본: JVM 시간대. JVM 시간대가 DB 서버 시간대와 다를 때 지정한다.
#agent.alert-log.timezone=Asia/Seoul

# 요청 한 번에 돌려줄 최대 줄 수(tail) / 항목 수(search).
# 기본 5000 - 앱 알럿 로그 팝업이 500 / 1000 / 5000 줄을 보여 주기 위한 값이다(2026-10-21). 허용 범위 10 ~ 20000.
# 앱 시스템 설정의 "알럿 로그 최대 줄 수"는 이 값 이하로 둔다.
#agent.alert-log.max-lines=5000

# 검색 한 번이 파일 끝에서 거슬러 읽을 최대 크기(MB). 이 한도에 닿으면 truncated=true 로 알린다.
#agent.alert-log.max-scan-mb=64

# 응답 본문 하나의 상한(바이트).
#agent.output.max-bytes=5242880

# ---------------------------------------------------------------------------------------------------
# 실행
# ---------------------------------------------------------------------------------------------------

# 작업 스레드 수(기본 4).
#agent.http.threads=4

# 로그·작업 디렉터리. 상대 경로는 이 파일이 있는 디렉터리 기준이다.
#agent.log-dir=logs
#agent.work-dir=work

# 이 버전은 TLS를 지원하지 않는다(예정). false 로 둔다.
#agent.tls.enabled=false
